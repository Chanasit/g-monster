                Rez.Drawables.CinderfangFightLeft
            ],
            "tidecaller" => [
                Rez.Drawables.TidecallerIdle, Rez.Drawables.TidecallerSleep, Rez.Drawables.TidecallerMove, Rez.Drawables.TidecallerFight,
