                Rez.Drawables.ShardpupFightLeft
            ],
            "cinderpip" => [
                Rez.Drawables.CinderpipIdle, Rez.Drawables.CinderpipSleep, Rez.Drawables.CinderpipMove, Rez.Drawables.CinderpipFight,
                Rez.Drawables.CinderpipFightLeft
            ],
            "silthatch" => [
                Rez.Drawables.SilthatchIdle, Rez.Drawables.SilthatchSleep, Rez.Drawables.SilthatchMove, Rez.Drawables.SilthatchFight,
                Rez.Drawables.SilthatchFightLeft
            ],
