                Rez.Drawables.VoltcrestIdle, Rez.Drawables.VoltcrestSleep, Rez.Drawables.VoltcrestMove, Rez.Drawables.VoltcrestFight,
                Rez.Drawables.VoltcrestFightLeft
            ],
            "thornmane" => [
                Rez.Drawables.ThornmaneIdle, Rez.Drawables.ThornmaneSleep, Rez.Drawables.ThornmaneMove, Rez.Drawables.ThornmaneFight,
                Rez.Drawables.ThornmaneFightLeft
            ],
            "galewing" => [
                Rez.Drawables.GalewingIdle, Rez.Drawables.GalewingSleep, Rez.Drawables.GalewingMove, Rez.Drawables.GalewingFight,
                Rez.Drawables.GalewingFightLeft
            ],
            "glacierjaw" => [
                Rez.Drawables.GlacierjawIdle, Rez.Drawables.GlacierjawSleep, Rez.Drawables.GlacierjawMove, Rez.Drawables.GlacierjawFight,
